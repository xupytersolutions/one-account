WXT_GOOGLE_CLIENT_ID=1028690921231-idhqso2dcto3ebj3t639f5tsqv425h3b.apps.googleusercontent.com
# Backend base URL (single build-time value, no runtime override)
WXT_SITE_URL=http://localhost:3000
